[Unit]
Description=GridWorks alerter tap to Opsgenie (gwalerter tap)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=alerter
WorkingDirectory=/home/alerter/gridworks-alerter
ExecStart=/home/alerter/gridworks-alerter/.venv/bin/gwalerter tap
Restart=always
RestartSec=5
MemoryMax=256M

[Install]
WantedBy=multi-user.target
