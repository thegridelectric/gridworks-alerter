# Copy to .env (gitignored) and fill in.
# Settings use the GWALERTER_ prefix; nested fields use the __ delimiter.

# Rabbit broker URL — amqp:// for non-TLS, amqps:// for TLS.
GWALERTER_RABBIT__URL=amqp://user:pass@localhost:5672/d1__1

# Routable service alias: <universe>.alerts (d1.alerts in dev, hw1.alerts in prod).
GWALERTER_SERVICE_ALIAS=d1.alerts

GWALERTER_LOG_LEVEL=INFO

# The registry subtrees this alerter pages for (comma-separated root
# aliases) and the registry's HTTP read for the boot forest request.
GWALERTER_FLEET_ROOTS=d1.isone.me.versant.keene
GWALERTER_GNR_URL=http://localhost:8000

# The control plane the Orchestrator tier answers to.
GWALERTER_SUPER_ALIAS=d1.super1
GWALERTER_TIME_COORDINATOR_ALIAS=d1.time

# Detector thresholds and cadence (seconds). NoData raises after this
# much silence from a tracked house; the detectors re-evaluate every tick.
GWALERTER_NO_DATA_SILENCE_S=600
GWALERTER_DETECTOR_TICK_S=10
# The NoData summary's cause: how often a house's scada and LTN are each
# expected to be heard from, whatever the message; a party is "speaking"
# when heard inside this period times the Nyquist factor (2.1).
GWALERTER_HEARD_PERIOD_S=60

# The tap (`gwalerter tap`): the Opsgenie integration API key and the
# team it pages (required), the API host (EU accounts use
# https://api.eu.opsgenie.com), and how often the tap reads the store's
# open alerts and tells Opsgenie: its only path, so the longest a page
# waits.
GWALERTER_OPSGENIE_API_KEY=
GWALERTER_OPSGENIE_TEAM_ID=
GWALERTER_OPSGENIE_URL=https://api.opsgenie.com
GWALERTER_TAP_RECONCILE_S=10

# The prober (`gwalerter probe`): the broker's two doors checked as a
# client of each. The AMQP broker client: the URL (host, port, vhost;
# the user and password count only without a tls block, on the dev
# broker) and, on a gated broker, the prober's own cert, CN = its FIS
# principal id, which makes the URL `amqps://…:5671` and the login
# cert-plus-claims as `<alias>.probe`. The MQTT listener the scadas use
# (TLS on the fleet's 8883, off on the dev broker's 1885). One probe per
# interval, BrokerUnreachable after this many failures running.
GWALERTER_PROBE_AMQP__URL=amqp://user:pass@localhost:5672/d1__1
#GWALERTER_PROBE_AMQP__TLS__CA_CERT_PATH=/home/alerter/.config/gridworks/alerter/certs/ca.crt
#GWALERTER_PROBE_AMQP__TLS__CERT_PATH=/home/alerter/.config/gridworks/alerter/certs/alerter-probe.crt
#GWALERTER_PROBE_AMQP__TLS__PRIVATE_KEY_PATH=/home/alerter/.config/gridworks/alerter/certs/alerter-probe.pem
GWALERTER_PROBE_MQTT_HOST=localhost
GWALERTER_PROBE_MQTT_PORT=1885
GWALERTER_PROBE_MQTT_TLS=false
GWALERTER_PROBE_INTERVAL_S=60
GWALERTER_PROBE_FAILURES_TO_RAISE=3
