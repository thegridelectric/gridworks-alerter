# Copy to .env (gitignored) and fill in.
# Settings use the GWALERTER_ prefix; nested fields use the __ delimiter.

# Rabbit broker URL — amqp:// for non-TLS, amqps:// for TLS.
GWALERTER_RABBIT__URL=amqp://user:pass@localhost:5672/d1__1

# Routable service alias: <universe>.alerts (d1.alerts in dev, hw1.alerts in prod).
GWALERTER_SERVICE_ALIAS=d1.alerts

GWALERTER_LOG_LEVEL=INFO
